<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/beauty_blue</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
        <item name="android:navigationBarColor">@color/beauty_navy</item>
        <item name="android:statusBarColor">@color/beauty_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppActionBar" parent="@android:style/Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/beauty_navy</item>
        <item name="android:titleTextStyle">@style/AppActionBarTitle</item>
    </style>

    <style name="AppActionBarTitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
